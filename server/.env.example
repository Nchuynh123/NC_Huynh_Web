# Lấy CHÍNH XÁC từ Supabase → Project Settings → Database → Connect → URI
# Mật khẩu có @ phải ghi %40 (vd: Abc@123 → Abc%40123)
# KHÔNG dùng dấu [ ] quanh mật khẩu
# Thêm: ?sslmode=require
#
# Ví dụ Direct:
# DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
#
# Ví dụ Pooler (copy từ dashboard, đúng region):
# DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

DATABASE_URL="postgresql://postgres:password@db.xxxxx.supabase.co:5432/postgres?sslmode=require"
PORT=3001
JWT_SECRET=your-super-secret-jwt-key-change-in-production
ADMIN_EMAIL=admin@band.local
ADMIN_PASSWORD=admin123456
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
PUBLIC_URL=http://localhost:3001

SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
